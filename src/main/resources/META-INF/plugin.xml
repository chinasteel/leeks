<idea-plugin>
    <id>com.huage2580.leeks</id>
    <name>Leeks</name>
    <version>2.1.5</version>
    <idea-version since-build="231.*" until-build="243.*"></idea-version>
    <vendor email="huage2580@gmail.com" url="http://github.com/huge2580">huage2580</vendor>
    <change-notes>
        <![CDATA[
        v1.1 增加了股票的tab，采用腾讯的行情接口，股票轮询间隔10s  <br>
        ]]>
    </change-notes>
    <description><![CDATA[
    提供基金和股票的实时行情查看，支持港股美股
    韭菜专用摸鱼插件!<br>
    韭菜专用摸鱼插件!<br>
    韭菜专用摸鱼插件!<br>
        good luck!<br>
        使用说明：https://github.com/huage2580/leeks
    ]]></description>

    <!-- please see http://www.jetbrains.org/intellij/sdk/docs/basics/getting_started/plugin_compatibility.html
         on how to target different products -->
    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Add your extensions here -->
        <toolWindow anchor="left" id="leeks" factoryClass="FundWindow"/>
        <applicationConfigurable id="leeks_settings" instance="SettingsWindow" displayName="Leeks"/>
        <notificationGroup id="Leeks Notification Group" displayType="BALLOON"/>
    </extensions>

    <actions>
        <!-- Add your actions here -->
    </actions>
</idea-plugin>